{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/design-anchored-development/schemas/policies.schema.json",
  "title": "DAD policies",
  "description": "Who can run each operation and which records they can see.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "action", "allow"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^POL-[A-Z0-9]+-[0-9]{3}$",
        "description": "Stable ID, e.g. POL-LOAN-002. Never reused."
      },
      "action": {
        "type": "string",
        "pattern": "^(query|mutation)\\.[a-z][A-Za-z0-9]*$",
        "description": "A root field of the GraphQL schema."
      },
      "allow": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "scope": {
        "type": "string",
        "description": "Optional row-level filter written against `viewer`."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "graphql_type"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "graphql_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        }
      },
      "source": { "type": "string" }
    }
  }
}
